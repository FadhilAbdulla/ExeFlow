diff -ru a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
--- a/dlls/winemac.drv/window.c	2026-11-25 02:31:38
+++ b/dlls/winemac.drv/window.c	2026-11-25 02:31:38
@@ -198,6 +198,29 @@
 
 
 /***********************************************************************
+ *              try_get_win_data
+ *
+ * Like get_win_data, but fails with *busy set instead of waiting for the lock.
+ */
+struct macdrv_win_data *try_get_win_data(HWND hwnd, bool *busy)
+{
+    struct macdrv_win_data *data;
+
+    *busy = false;
+    if (!hwnd) return NULL;
+    if (pthread_mutex_trylock(&win_data_mutex))
+    {
+        *busy = true;
+        return NULL;
+    }
+    if (win_datas && (data = (struct macdrv_win_data *)CFDictionaryGetValue(win_datas, hwnd)))
+        return data;
+    pthread_mutex_unlock(&win_data_mutex);
+    return NULL;
+}
+
+
+/***********************************************************************
  *              release_win_data
  *
  * Release the data returned by get_win_data.
